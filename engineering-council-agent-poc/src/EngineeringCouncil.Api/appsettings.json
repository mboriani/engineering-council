{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OUTPUTS_ROOT": "outputs",
  "Evidence": {
    "ProviderFailureMode": "Continue",
    "Execution": {
      "MaxConcurrency": 1,
      "ProviderTimeout": 120,
      "MaxAttempts": 2
    },
    "Providers": [ "Mock" ],
    "Claude": {
      "Enabled": false,
      "ApiKeyEnvironmentVariable": "ANTHROPIC_API_KEY",
      "Model": "claude-sonnet-5"
    },
    "OpenAI": {
      "Enabled": false,
      "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
      "Model": "gpt-4o-mini"
    },
    "OpenCode": {
      "Enabled": false,
      "Executable": "opencode",
      "TimeoutSeconds": 120
    }
  },

  "Council": {
    "SemanticReconciliation": {
      "Enabled": false,
      "Model": "claude-sonnet-5",
      "MaxOutputTokens": 300,
      "TimeoutSeconds": 60
    }
  }
}
