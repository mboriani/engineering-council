{
  "Evidence": {
    "ProviderFailureMode": "Continue",

    // Milestone 015.1 — max acquisition steps executed concurrently. 1 (default) is
    // strictly sequential; a 3-provider council sets 3 so OpenCode/Codex/Claude Code
    // overlap instead of serializing (~150s → slowest provider).
    "Execution": {
      "MaxConcurrency": 1,

      // Milestone 015.2B — FALLBACK per-step timeout in seconds. A provider with its
      // own configured timeout (Evidence:OpenCode/Codex/ClaudeCode:TimeoutSeconds)
      // uses that instead; this global value only applies when a provider has none.
      "ProviderTimeout": 300,

      // Milestone 015.3B — max acquisition attempts per logical step. 2 (default)
      // allows ONE bounded retry of a retry-eligible (Timeout-only) failure with the
      // SAME effective timeout. 1 disables step-level retry; capped at 5.
      "MaxAttempts": 1
    },

    // Offline by default. Select a real provider explicitly (--provider Claude) or
    // list it here; doing so sends selected repository content to that service.
    "Providers": [
      { "Name": "OpenCode", "Scope": "Discipline" }
    ],

    "Context": {
      "MaximumFiles": 200,
      "MaximumCharacters": 500000,
      "MaximumCharactersPerFile": 8000
    },

    "Claude": {
      "Enabled": false,
      "ApiKeyEnvironmentVariable": "ANTHROPIC_API_KEY",
      "Model": "claude-sonnet-5",
      "MaxOutputTokens": 8000,
      "TimeoutSeconds": 120,
      "MaxRetries": 2
    },

    "OpenAI": {
      "Enabled": false,
      "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
      "Model": "gpt-4o-mini",
      "MaxOutputTokens": 8000,
      "TimeoutSeconds": 120,
      "MaxRetries": 2
    },

    "OpenCode": {
      "Enabled": true,
      "Executable": "opencode",
      "TimeoutSeconds": 300,
      // Optional explicit model in OpenCode's provider/model format, passed as
      // `opencode run --model <id>`. Set to Nemotron 3 Ultra for M15.6A evaluation.
      // Credentials stay in OpenCode's own auth (OpenCode Zen api credential) — never here.
      "Model": "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
      // Optional OpenCode local-server port, passed as `opencode run --port <n>` (or
      // bare `--port` for a random free port when set to 0). When set, the run starts
      // its OWN local server instead of competing for the shared OpenCode server an
      // interactive session may hold — a busy shared server can otherwise queue the run
      // until the timeout (M14.1). Unset/empty keeps OpenCode's default discovery.
      "Port": 0
    },

    "Codex": {
      "Enabled": false,
      "Executable": "codex",
      "TimeoutSeconds": 120,
      // Optional explicit Codex model (e.g. "gpt-5.4-mini"), passed as `codex exec -m <model>`.
      // Unset/empty ⇒ Codex uses its own configured/default model.
      // Credentials stay in Codex's own auth (`codex login` / ChatGPT account) — never here.
      "Model": ""
    },

    "ClaudeCode": {
      "Enabled": false,
      "Executable": "claude",
      "TimeoutSeconds": 300,
      // Optional explicit Claude Code model (e.g. "sonnet"), passed as `claude -p --model <model>`.
      // Unset/empty ⇒ Claude Code uses its own configured/default model.
      // Credentials stay in Claude Code's own auth (`claude auth` / the configured account) — never here.
      "Model": ""
    }
  },

  "Council": {
    // Targeted semantic reconciliation (Milestone 014.4): reviews ONLY consolidated
    // findings whose deterministic Council assessment flags an ObservationType
    // disagreement (2/13 in the real M14.1 fixture — see MILESTONE-014.3's Decision
    // B). Disabled by default; when enabled, reuses the configured Claude client.
    "SemanticReconciliation": {
      "Enabled": false,
      "Model": "claude-sonnet-5",
      "MaxOutputTokens": 300,
      "TimeoutSeconds": 60
    }
  },

  // Graph-assisted agentic context (M16.3) — disabled by default.
  // When enabled, provides discipline-specific navigation context to agentic providers.
  "GraphAssistance": {
    "Enabled": false,
    "CacheDirectory": "outputs/graph-cache",
    "GraphifyExecutable": "graphify",
    "ExtractionTimeoutSeconds": 30
  }
}
